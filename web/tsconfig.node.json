{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `src/lint-rules.test.ts` chạy trong NODE, không trong trình duyệt: nó spawn eslint để
   * kiểm chính cái cổng lint. Nên nó thuộc project này (types: node) chứ không thuộc
   * `tsconfig.app.json` (types: vite/client) — ở đó `node:fs`, `__dirname`, `process`
   * đều là lỗi biên dịch.
   */
  "include": ["vite.config.ts", "src/lint-rules.test.ts"]
}
