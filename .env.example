# ===== IMS — biến môi trường (KHÔNG chứa bí mật; bí mật nằm ở secrets/*, AD-11) =====
NODE_ENV=production

# Postgres
POSTGRES_USER=ims
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=ims
# Cổng loopback cho TẦNG TEST CHẠM DB THẬT (`npm --prefix api run test:db`). Chỉ được mở bởi
# `docker-compose.override.e2e.yml`, không bao giờ đi cùng production. Đổi nếu 55432 đã bị chiếm.
POSTGRES_TEST_PORT=55432
REDIS_TEST_PORT=56379
SMTP_TEST_PORT=51025

# Redis
REDIS_PASSWORD=doi-mat-khau-nay

# URL hệ thống — dùng để kiểm header Origin (chống CSRF) và dựng link trong email.
APP_BASE_URL=https://ims.pmh.com.vn

# SMTP: dev để trống (mailpit). Prod điền host thật; mật khẩu vào secrets/smtp_password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=

# Thư mục chứa cert wildcard *.pmh.com.vn (fullchain.pem + privkey.pem)
TLS_CERT_DIR=./ops/certs

# Cổng HOST của container web. Để trống là 443/80 — đúng cấu hình production, đừng đổi ở đó.
# Máy dev nào đã có reverse proxy khác giữ cổng 80 thì đặt WEB_HTTP_PORT=8080, nếu không
# `docker compose up` chết với "port is already allocated" và E2E không chạy được.
# Cổng 80 trong container chỉ làm 301 sang HTTPS nên đổi cổng host không ảnh hưởng E2E.
#WEB_HTTPS_PORT=443
#WEB_HTTP_PORT=8080
