# ===== IMS — biến môi trường (KHÔNG chứa bí mật; bí mật nằm ở secrets/*, AD-11) =====
NODE_ENV=production

# Postgres
POSTGRES_USER=ims
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=ims
# `POSTGRES_USER` là SUPERUSER của cụm: chỉ dùng để dựng role chủ sở hữu (ops/db/) và cho các
# script vận hành (sao lưu, healthcheck). Ứng dụng và migration đều KHÔNG dùng nó.
#
# DB-03: migration chạy bằng `ims_owner` — chủ database và mọi bảng, KHÔNG superuser, chỉ có
# CREATEROLE để quản `ims_app`. Cụm mới: postgres tự tạo role lúc initdb. Cụm đã có dữ liệu:
# chạy `bash ops/db-owner-bootstrap.sh` một lần (RUNBOOK, mục nâng cấp).
MIGRATION_DB_PASSWORD=doi-mat-khau-nay
#
# D-01: ứng dụng KHÔNG chạy bằng hai role trên. Ứng dụng kết nối bằng `ims_app`, một role hẹp
# không sở hữu bảng nào, nên nó không tháo được trigger append-only của `audit_log` (NFR-03).
# Service `migrate` tự tạo role và đặt mật khẩu này; xem `0048_app_role_split.sql`.
#
# KHÔNG có biến `APP_DB_USER` (§18 #7, bỏ 21/09). Nó từng nằm ở đây và trông như một cái núm
# đổi được, nhưng `0048` tạo role bằng đúng chuỗi `ims_app` ở chín câu lệnh — và migration đã
# chạy thì không sửa được. Đặt khác đi cho ra một `.env` hợp lệ, một role chưa từng được tạo,
# và một API không boot. Một cái núm không nối dây tệ hơn không có núm nào.
# Các mật khẩu DB đi thẳng vào chuỗi kết nối, KHÔNG được URL-encode. Dùng chữ, số và
# dấu `-` `_` thôi — một dấu `@` hay `:` trong đó là chuỗi kết nối bị cắt sai chỗ, và
# lỗi hiện ra dưới dạng "không phân giải được host" chứ không nói gì về mật khẩu.
APP_DB_PASSWORD=doi-mat-khau-nay
# Cổng loopback cho TẦNG TEST CHẠM DB THẬT (`npm --prefix api run test:db`). Chỉ được mở bởi
# `docker-compose.override.e2e.yml`, không bao giờ đi cùng production. Đổi nếu 55432 đã bị chiếm.
POSTGRES_TEST_PORT=55432
REDIS_TEST_PORT=56379
SMTP_TEST_PORT=51025

# Redis
REDIS_PASSWORD=doi-mat-khau-nay

# URL hệ thống — dùng để kiểm header Origin (chống CSRF) và dựng link trong email.
APP_BASE_URL=https://ims.pmh.com.vn

# SMTP — BẮT BUỘC khai, compose không chạy nếu thiếu.
#   Prod (Google Workspace): SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=ims@pmh.com.vn
#                            App Password vào secrets/smtp_password
#   Dev (mailpit, chạy với --profile dev): SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_USER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=

# Thư mục chứa cert wildcard *.pmh.com.vn (fullchain.pem + privkey.pem)
TLS_CERT_DIR=./ops/certs

# Cổng HOST của container web. Để trống là 443/80 — đúng cấu hình production, đừng đổi ở đó.
# Máy dev nào đã có reverse proxy khác giữ cổng 80 thì đặt WEB_HTTP_PORT=8080, nếu không
# `docker compose up` chết với "port is already allocated" và E2E không chạy được.
# Cổng 80 trong container chỉ làm 301 sang HTTPS nên đổi cổng host không ảnh hưởng E2E.
#WEB_HTTPS_PORT=443
#WEB_HTTP_PORT=8080
